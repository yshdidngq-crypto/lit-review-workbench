      "color": "#d97706"
    },
    {
      "id": "T5",
      "name": "下游任务集成",
      "desc": "面向检测/分割等任务的联合优化",
      "color": "#6b4bbd"
    },
    {
      "id": "T6",
      "name": "综述与外围",
      "desc": "领域综述、方法借鉴与关联较弱的工作",
      "color": "#8d9db2"
    }
  ],
  "stages": [
    {
      "id": "S1",
      "name": "数据准备与跨模态预处理",
      "desc": "按时间戳完成 RGB-T 配对、分辨率差异处理、必要增强"
    },
    {
      "id": "S2",
      "name": "局部特征检测与描述",
      "desc": "SuperPoint 等检测器在建筑立面（窗框、边缘、角点）上的响应分布"
    },
    {
      "id": "S3",
      "name": "跨模态特征匹配",
      "desc": "SuperGlue / LoFTR 产生候选对应关系，含粗匹配与精匹配"
    },
    {
      "id": "S4",
      "name": "初始配准与几何候选生成",
      "desc": "由候选对应关系估计初始变换，形成多个候选解"
    },
    {
      "id": "S5",
      "name": "变换模型估计",
      "desc": "四自由度相似变换 [s, θ, tx, ty] 的求解"
    },
    {
      "id": "S6",
      "name": "几何先验与候选筛选",
      "desc": "按尺度范围、旋转范围、匹配点空间覆盖筛选候选"
    },
    {
      "id": "S7",
      "name": "RANSAC 与最小二乘精化",
      "desc": "剔除外点后用内点集最小二乘重估变换"
    },
    {
      "id": "S8",
      "name": "建筑结构验证",
      "desc": "检查层线水平、竖线垂直，判断几何解是否物理合理"
    },
    {
      "id": "S9",
      "name": "弱纹理与重复纹理处理",
      "desc": "窗户阵列导致的多解、弱纹理区的匹配缺失"
    },
    {
      "id": "S10",
      "name": "配准质量独立评价",
      "desc": "用独立指标评估最终配准结果，而非仅看拟合内点残差"
    }
  ],
